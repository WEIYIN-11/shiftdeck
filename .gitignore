# 引擎：安裝時取得，不進版控（14,000+ 檔案）
vendor/

# 使用者的簡報專案
# 用 projects/* 而非 projects/——git 無法用 ! 重新納入被忽略目錄底下的檔案，
# 寫成 projects/ 會連 .gitkeep 一起排除，clone 下來就沒有這個資料夾
projects/*
!projects/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 環境變數（絕不進版控）
.env
.env.*
!.env.example

# 作業系統
.DS_Store
Thumbs.db
desktop.ini

# 編輯器
.vscode/
.idea/
*.swp

# 驗收用測試檔（不進版控）
verify/

# 主控台的執行時狀態：收件匣、agent 狀態、上傳的材料
# 這些是這台機器上的當下狀態，不是專案內容
.shiftdeck/
