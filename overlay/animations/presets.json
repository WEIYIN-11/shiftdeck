      { "key": "entrance_fly", "label_en": "Fly In", "label_zh": "飞入", "label_zh_tw": "飛入", "label_ja": "スライドイン" },
      { "key": "entrance_wipe", "label_en": "Wipe", "label_zh": "擦除", "label_zh_tw": "擦除", "label_ja": "ワイプ" },
      { "key": "entrance_zoom", "label_en": "Zoom", "label_zh": "缩放", "label_zh_tw": "縮放", "label_ja": "ズーム" },
      { "key": "entrance_float", "label_en": "Float In", "label_zh": "浮入", "label_zh_tw": "浮入", "label_ja": "フロートイン" },
      { "key": "entrance_split", "label_en": "Split", "label_zh": "劈裂", "label_zh_tw": "劈裂", "label_ja": "スプリット" },
      { "key": "entrance_grow_and_turn", "label_en": "Grow & Turn", "label_zh": "放大旋转", "label_zh_tw": "放大旋轉", "label_ja": "拡大回転" },
      { "key": "entrance_appear", "label_en": "Appear", "label_zh": "出现", "label_zh_tw": "出現", "label_ja": "出現" }
