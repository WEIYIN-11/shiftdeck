      { "key": "path_circle", "label_en": "Circle", "label_zh": "圆形", "label_zh_tw": "圓形", "label_ja": "円" },
      { "key": "path_s_curve1", "label_en": "S Curve", "label_zh": "S 形曲线", "label_zh_tw": "S 形曲線", "label_ja": "S字カーブ" },
      { "key": "path_zigzag", "label_en": "Zigzag", "label_zh": "锯齿形", "label_zh_tw": "鋸齒形", "label_ja": "ジグザグ" }
    ],
    "exit": [
      { "key": "exit_fade", "label_en": "Fade Out", "label_zh": "淡出", "label_zh_tw": "淡出", "label_ja": "フェードアウト" },
      { "key": "exit_fly", "label_en": "Fly Out", "label_zh": "飞出", "label_zh_tw": "飛出", "label_ja": "スライドアウト" },
      { "key": "exit_wipe", "label_en": "Wipe Out", "label_zh": "擦除消失", "label_zh_tw": "擦除消失", "label_ja": "ワイプアウト" },
      { "key": "exit_zoom", "label_en": "Zoom Out", "label_zh": "缩放消失", "label_zh_tw": "縮放消失", "label_ja": "ズームアウト" },
      { "key": "exit_float", "label_en": "Float Out", "label_zh": "浮出", "label_zh_tw": "浮出", "label_ja": "フロートアウト" },
      { "key": "exit_split", "label_en": "Split Out", "label_zh": "劈裂消失", "label_zh_tw": "劈裂消失", "label_ja": "スプリットアウト" },
      { "key": "exit_dissolve", "label_en": "Dissolve Out", "label_zh": "溶解消失", "label_zh_tw": "溶解消失", "label_ja": "ディゾルブアウト" },
      { "key": "exit_appear", "label_en": "Disappear", "label_zh": "消失", "label_zh_tw": "消失", "label_ja": "消去" }
