      { "key": "emphasis_spin", "label_en": "Spin", "label_zh": "陀螺旋转", "label_zh_tw": "陀螺旋轉", "label_ja": "スピン" },
      { "key": "emphasis_teeter", "label_en": "Teeter", "label_zh": "跷跷板", "label_zh_tw": "蹺蹺板", "label_ja": "シーソー" },
      { "key": "emphasis_transparency", "label_en": "Transparency", "label_zh": "透明", "label_zh_tw": "透明", "label_ja": "透明度" },
      { "key": "emphasis_flash_bulb", "label_en": "Flash Bulb", "label_zh": "闪光灯", "label_zh_tw": "閃光燈", "label_ja": "フラッシュ" },
      { "key": "emphasis_bold_flash", "label_en": "Bold Flash", "label_zh": "加粗闪烁", "label_zh_tw": "加粗閃爍", "label_ja": "ボールドフラッシュ" },
      { "key": "emphasis_vertical_grow", "label_en": "Vertical Grow", "label_zh": "垂直放大", "label_zh_tw": "垂直放大", "label_ja": "垂直拡大" },
      { "key": "emphasis_wave", "label_en": "Wave", "label_zh": "波浪", "label_zh_tw": "波浪", "label_ja": "ウェーブ" }
    ],
    "path": [
      { "key": "path_right", "label_en": "Move Right", "label_zh": "向右移动", "label_zh_tw": "向右移動", "label_ja": "右へ移動" },
      { "key": "path_left", "label_en": "Move Left", "label_zh": "向左移动", "label_zh_tw": "向左移動", "label_ja": "左へ移動" },
      { "key": "path_up", "label_en": "Move Up", "label_zh": "向上移动", "label_zh_tw": "向上移動", "label_ja": "上へ移動" },
      { "key": "path_down", "label_en": "Move Down", "label_zh": "向下移动", "label_zh_tw": "向下移動", "label_ja": "下へ移動" },
