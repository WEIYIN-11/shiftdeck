  "presets": [
    {
      "id": "professional",
      "label_en": "Professional & composed",
      "label_zh": "专业沉稳",
      "label_zh_tw": "專業沉穩",
      "label_ja": "プロフェッショナル",
      "desc_en": "Fade-led, no motion paths, short durations. Built for external business decks where motion must never compete with the argument.",
      "desc_zh": "以淡入为主、无路径动画、时长偏短。适合对外商务简报，动效不与论点争夺注意力。",
      "desc_zh_tw": "以淡入為主、無路徑動畫、時長偏短。適合對外商務簡報，動效不與論點爭奪注意力。",
      "desc_ja": "フェード中心、モーションパスなし、短めの再生時間。動きが主張を邪魔しない社外向けデッキ用。",
      "defaults": {
        "transition": { "effect": "fade", "duration": 0.35 },
        "animation": { "effect": "none", "duration": 0.35, "stagger": 0.15, "trigger": "after-previous" }
      },
      "page_roles": {
        "cover": { "transition": { "effect": "fade", "duration": 0.5 } },
        "section": { "transition": { "effect": "fade", "duration": 0.5 } },
        "closing": { "transition": { "effect": "fade", "duration": 0.5 } }
      },
      "elements": {
        "title": { "effects": [{ "effect": "entrance_fade", "duration": 0.3 }] },
        "chart": { "effects": [{ "effect": "entrance_wipe", "effect_options": { "direction": "right" }, "duration": 0.45 }] },
        "kpi": { "effects": [{ "effect": "entrance_fade", "duration": 0.3 }] },
        "card": { "effects": [{ "effect": "entrance_fade", "duration": 0.3 }] },
        "takeaway": { "effects": [{ "effect": "entrance_fade", "duration": 0.35 }] },
        "image": { "effects": [{ "effect": "entrance_fade", "duration": 0.4 }] },
        "default": { "effects": [{ "effect": "entrance_fade", "duration": 0.3 }] }
      }
    },
    {
      "id": "lively",
      "label_en": "Light & lively",
      "label_zh": "轻快活泼",
      "label_zh_tw": "輕快活潑",
      "label_ja": "軽快で活発",
      "desc_en": "Measured fly-in and zoom with item-by-item reveals. Built for internal training and sharing sessions where pacing carries the talk.",
      "desc_zh": "适度飞入与缩放、逐项揭示。适合内训与分享场合，用节奏带动讲述。",
      "desc_zh_tw": "適度飛入與縮放、逐項揭示。適合內訓與分享場合，用節奏帶動講述。",
      "desc_ja": "適度なスライドインとズーム、項目ごとの表示。社内研修や共有セッション向け。",
      "defaults": {
        "transition": { "effect": "push", "effect_options": { "direction": "up" }, "duration": 0.5 },
        "animation": { "effect": "none", "duration": 0.45, "stagger": 0.25, "trigger": "after-previous" }
      },
      "page_roles": {
        "cover": { "transition": { "effect": "fade", "duration": 0.6 } },
        "section": { "transition": { "effect": "push", "effect_options": { "direction": "up" }, "duration": 0.6 } },
        "closing": { "transition": { "effect": "fade", "duration": 0.6 } }
      },
      "elements": {
        "title": { "effects": [{ "effect": "entrance_fade", "duration": 0.4 }] },
        "chart": { "effects": [{ "effect": "entrance_wipe", "effect_options": { "direction": "right" }, "duration": 0.6 }] },
        "kpi": { "effects": [{ "effect": "entrance_zoom", "effect_options": { "direction": "in" }, "duration": 0.45 }] },
        "card": { "effects": [{ "effect": "entrance_fly", "effect_options": { "direction": "down" }, "duration": 0.45 }] },
        "takeaway": {
          "effects": [
            { "effect": "entrance_fade", "duration": 0.4 },
            { "effect": "emphasis_grow_shrink", "effect_options": { "size": 108 }, "duration": 0.5, "delay": 0.2 }
          ]
        },
        "image": { "effects": [{ "effect": "entrance_zoom", "effect_options": { "direction": "in_slightly" }, "duration": 0.5 }] },
        "default": { "effects": [{ "effect": "entrance_fade", "duration": 0.4 }] }
      }
    },
    {
      "id": "minimal",
      "label_en": "Minimal & undistracting",
      "label_zh": "极简无干扰",
      "label_zh_tw": "極簡無干擾",
      "label_ja": "ミニマル",
      "desc_en": "Page transitions only; nothing moves inside a page. Built for data-dense decks that are read rather than performed.",
      "desc_zh": "只保留页间转场，页内完全不动。适合资料密集、供阅读而非表演的简报。",
      "desc_zh_tw": "只保留頁間轉場，頁內完全不動。適合資料密集、供閱讀而非表演的簡報。",
      "desc_ja": "ページ切り替えのみ、ページ内は動かさない。読ませるためのデータ密度の高いデッキ向け。",
      "defaults": {
        "transition": { "effect": "fade", "duration": 0.25 },
        "animation": { "effect": "none", "duration": 0.3, "stagger": 0.1, "trigger": "after-previous" }
      },
      "page_roles": {},
      "elements": {}
    }
  ]
}
