{
  "version": 1,
  "note": "shiftdeck deck animation presets. Effect keys are validated against vendor/ppt-master/skills/ppt-master/scripts/pptx_animation_presets.json at load time; this file only curates and localizes, it never redefines an effect.",
  "element_classes": [
    {
      "id": "title",
      "match": ["title", "cover-", "chapter-", "section-", "subtitle", "tagline", "headline", "heading", "head"]
    },
    {
      "id": "takeaway",
      "match": ["takeaway", "callout", "quote", "conclusion", "verdict", "outcome", "footnote", "note", "source", "summary", "insight"]
    },
    {
      "id": "chart",
      "match": ["chart", "table", "graph", "legend", "timeline", "track", "matrix", "axis", "plot"]
    },
    {
      "id": "kpi",
      "match": ["kpi", "metric", "gauge", "stat", "number", "score"]
    },
    {
      "id": "image",
      "match": ["image", "img-", "figure", "photo", "hero", "visual", "illustration"]
    },
    {
      "id": "card",
      "match": ["card", "item", "step-", "stage-", "pillar-", "tier-", "principle-", "row-", "quadrant-", "column-", "col-", "block-", "node-", "phase-", "bullet", "point-"]
    }
  ],
  "page_roles": [
    {
      "id": "cover",
      "match": ["cover", "title", "opening", "hero"]
    },
    {
      "id": "section",
      "match": ["section", "chapter", "divider", "agenda"]
    },
    {
      "id": "closing",
      "match": ["closing", "ending", "thanks", "thank", "qa", "wrapup", "conclusion"]
    },
    {
      "id": "data",
      "match": ["data", "chart", "kpi", "dashboard", "metric", "result", "finance", "table"]
    }
  ],
  "seed_options": {
    "emphasis_grow_shrink": { "size": 150 },
    "emphasis_transparency": { "amount": 0.5 },
    "emphasis_spin": { "amount": 360 }
  },
  "option_labels": {
    "direction": {
      "up": { "en": "Up", "zh": "上", "zh_tw": "上", "ja": "上" },
      "right": { "en": "Right", "zh": "右", "zh_tw": "右", "ja": "右" },
      "down": { "en": "Down", "zh": "下", "zh_tw": "下", "ja": "下" },
      "left": { "en": "Left", "zh": "左", "zh_tw": "左", "ja": "左" },
      "up_left": { "en": "Up left", "zh": "左上", "zh_tw": "左上", "ja": "左上" },
      "up_right": { "en": "Up right", "zh": "右上", "zh_tw": "右上", "ja": "右上" },
      "down_right": { "en": "Down right", "zh": "右下", "zh_tw": "右下", "ja": "右下" },
      "down_left": { "en": "Down left", "zh": "左下", "zh_tw": "左下", "ja": "左下" },
      "in": { "en": "In", "zh": "由小放大", "zh_tw": "由小放大", "ja": "小さく→大きく" },
      "out": { "en": "Out", "zh": "由大缩小", "zh_tw": "由大縮小", "ja": "大きく→小さく" },
      "in_slightly": { "en": "In slightly", "zh": "轻微放大", "zh_tw": "輕微放大", "ja": "わずかに拡大" },
      "out_slightly": { "en": "Out slightly", "zh": "轻微缩小", "zh_tw": "輕微縮小", "ja": "わずかに縮小" },
      "in_center": { "en": "In from center", "zh": "自页面中心", "zh_tw": "自頁面中心", "ja": "中央から" },
      "out_center": { "en": "Out to center", "zh": "退向页面中心", "zh_tw": "退向頁面中心", "ja": "中央へ" },
      "in_bottom": { "en": "In from bottom", "zh": "自页面底部", "zh_tw": "自頁面底部", "ja": "下から" },
      "out_bottom": { "en": "Out to bottom", "zh": "退向页面底部", "zh_tw": "退向頁面底部", "ja": "下へ" },
      "horizontal_in": { "en": "Horizontal in", "zh": "水平向内", "zh_tw": "水平向內", "ja": "水平内向き" },
      "horizontal_out": { "en": "Horizontal out", "zh": "水平向外", "zh_tw": "水平向外", "ja": "水平外向き" },
      "vertical_in": { "en": "Vertical in", "zh": "垂直向内", "zh_tw": "垂直向內", "ja": "垂直内向き" },
      "vertical_out": { "en": "Vertical out", "zh": "垂直向外", "zh_tw": "垂直向外", "ja": "垂直外向き" }
