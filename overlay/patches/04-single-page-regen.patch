+# --- shiftdeck overlay: incremental single-page finalize ---------------------
+# ``pages=None`` reproduces the upstream whole-directory behavior exactly; a
+# page set restricts every pass to those files so a one-page edit does not pay
+# for the whole deck's icon expansion / image embedding / text flattening.
+def _candidate_svgs(candidate_dir: Path, pages: set[str] | None = None):
+    """Yield the SVGs this run should process (all of them unless filtered)."""
+    files = candidate_dir.glob('*.svg')
+    if pages is None:
+        return files
+    return [svg_file for svg_file in files if svg_file.name in pages]
+
+
+def _reuse_published_pages(
+    candidate_dir: Path,
+    svg_final: Path,
+    pages: set[str],
+) -> set[str]:
+    """Carry already-published pages into the candidate and return what to process.
+
+    Every page outside ``pages`` that already exists in ``svg_final/`` is copied
+    over with ``copy2`` (metadata preserved, so an untouched page keeps its
+    mtime) and skipped. A page with no published copy is added back to the
+    process set, so an incremental run can never publish less than a full one.
+    """
+    process = set(pages)
+    for svg_file in candidate_dir.glob('*.svg'):
+        if svg_file.name in process:
+            continue
+        published = svg_final / svg_file.name
+        if published.is_file():
+            shutil.copy2(published, svg_file)
+        else:
+            process.add(svg_file.name)
+    return process
+
