@@ -143,6 +143,35 @@ def _shiftdeck_animations():
     return _SHIFTDECK_ANIMATIONS
 
 
+# --- shiftdeck overlay: selection channel + single-page regeneration ----------
+# Same degradation contract as the animation overlay: no overlay directory =>
+# ``available: false`` and the browser hides the page-type picker entirely.
+_SHIFTDECK_REGEN: Optional[object] = None
+_SHIFTDECK_REGEN_TRIED = False
+
+
+def _shiftdeck_regen():
+    """Import the shiftdeck regeneration overlay once, or return ``None``."""
+    global _SHIFTDECK_REGEN, _SHIFTDECK_REGEN_TRIED
+    if _SHIFTDECK_REGEN_TRIED:
+        return _SHIFTDECK_REGEN
+    _SHIFTDECK_REGEN_TRIED = True
+    for parent in _ROOT_SCRIPTS_DIR.parents:
+        overlay = parent / 'overlay' / 'regen'
+        if not (overlay / 'shiftdeck_regen.py').is_file():
+            continue
+        if str(overlay) not in sys.path:
+            sys.path.insert(0, str(overlay))
+        try:
+            import shiftdeck_regen  # noqa: PLC0415
+        except ImportError as exc:
+            logger.warning('shiftdeck regen overlay not importable: %s', exc)
+            break
+        _SHIFTDECK_REGEN = shiftdeck_regen
+        break
+    return _SHIFTDECK_REGEN
+
