+
+    # --- shiftdeck overlay: selection channel + single-page regeneration -----
+    @app.route('/api/pagetypes')
+    def get_pagetypes():
+        """Serve the page-type picker: ids, four-language labels, thumbnails.
+
+        The thumbnail is the page type's own ``skeleton.svg`` as a data URI, so
+        the picker shows the real layout with zero extra build steps.
+        """
+        overlay = _shiftdeck_regen()
+        if overlay is None:
+            return jsonify({'available': False})
+        try:
+            payload = {
+                'available': True,
+                'page_types': overlay.ui_page_types(),
+                'keep': overlay.KEEP_PAGE_TYPE,
+            }
+        except (OSError, ValueError, json.JSONDecodeError) as exc:
+            logger.warning('page type catalog unavailable: %s', exc)
+            return jsonify({'available': False, 'error': str(exc)}), 500
+        resp = jsonify(payload)
+        resp.headers['Cache-Control'] = 'no-store'
+        return resp
+
+    @app.route('/api/selection')
+    def get_selection():
+        """Return the selection state the preview last recorded."""
+        overlay = _shiftdeck_regen()
+        if overlay is None:
+            return jsonify({'available': False})
+        return jsonify({
+            'available': True,
+            'current': overlay.read_current(project_path),
+        })
+
+    @app.route('/api/selection', methods=['POST'])
+    def post_selection():
+        """Record page/element selection so a later AI turn can resolve "this".
+
+        Borrowed from open-slide's dev-server design (the idea only — none of
+        its code): the editor owns "what is selected right now" and publishes it
+        to a file, instead of the user having to retype a filename in chat.
+        """
+        overlay = _shiftdeck_regen()
+        if overlay is None:
+            return jsonify({'error': 'regen overlay unavailable'}), 404
+        payload = request.get_json(silent=True)
+        if not isinstance(payload, dict):
+            return jsonify({'error': 'invalid payload'}), 400
+        slide = payload.get('slide')
+        if slide is not None:
+            if _safe_svg_path(str(slide)) is None:
+                return jsonify({'error': 'invalid slide name'}), 400
+        elements = payload.get('elements')
+        selection = {
+            'slide': slide,
+            'index': payload.get('index'),
+            'total': payload.get('total'),
+            'element': payload.get('element'),
+            'elements': elements if isinstance(elements, list) else [],
+        }
+        # Skip redundant disk writes: navigation fires this on every click.
+        signature = json.dumps(selection, ensure_ascii=False, sort_keys=True)
+        if app.config.get('SHIFTDECK_SELECTION_SIG') == signature:
+            return jsonify({'status': 'unchanged'})
+        try:
+            written = overlay.write_current(project_path, selection)
+        except OSError as exc:
+            return jsonify({'error': str(exc)}), 500
+        app.config['SHIFTDECK_SELECTION_SIG'] = signature
+        return jsonify({'status': 'ok', 'current': written})
+
+    @app.route('/api/regen')
+    def get_regen():
+        """Return the pending regeneration request, if any."""
+        overlay = _shiftdeck_regen()
+        if overlay is None:
+            return jsonify({'available': False})
+        resp = jsonify({
+            'available': True,
+            'request': overlay.read_request(project_path),
+            'receipt': overlay.read_receipt(project_path),
+        })
+        resp.headers['Cache-Control'] = 'no-store'
+        return resp
+
+    @app.route('/api/regen', methods=['POST'])
+    def post_regen():
+        """Queue "redraw this page as this page type" for the next AI turn.
+
+        The server only records the request — it never redraws. Authoring stays
+        with the AI; this endpoint is the handoff point that makes "this page"
+        unambiguous.
+        """
+        overlay = _shiftdeck_regen()
+        if overlay is None:
+            return jsonify({'error': 'regen overlay unavailable'}), 404
+        payload = request.get_json(silent=True)
+        if not isinstance(payload, dict):
+            return jsonify({'error': 'invalid payload'}), 400
+        slide = str(payload.get('slide') or '')
+        svg_file = _safe_svg_path(slide) if slide else None
+        if svg_file is None or not svg_file.exists():
+            return jsonify({'error': 'invalid slide name'}), 400
+        page_type = str(payload.get('page_type') or overlay.KEEP_PAGE_TYPE)
+        try:
+            known = set(overlay.page_type_ids()) | {overlay.KEEP_PAGE_TYPE}
+        except (OSError, ValueError, json.JSONDecodeError) as exc:
+            return jsonify({'error': str(exc)}), 500
+        if page_type not in known:
+            return jsonify({'error': f'unknown page type: {page_type}'}), 400
+        try:
+            written = overlay.write_request(
+                project_path,
+                slide=slide,
+                page_type=page_type,
+                note=payload.get('note') or '',
+            )
+        except OSError as exc:
+            return jsonify({'error': str(exc)}), 500
+        logger.info('regeneration requested: %s -> %s', slide, page_type)
+        return jsonify({'status': 'ok', 'request': written})
+
+    @app.route('/api/regen/cancel', methods=['POST'])
+    def cancel_regen():
+        """Withdraw the pending regeneration request."""
+        overlay = _shiftdeck_regen()
+        if overlay is None:
+            return jsonify({'error': 'regen overlay unavailable'}), 404
+        closed = overlay.close_request(project_path, overlay.STATUS_CANCELLED)
+        return jsonify({'status': 'ok', 'request': closed})
+
