+
+# --- shiftdeck overlay: auto-expand the confirmed deck animation preset -------
+# The confirmation page can only record the chosen preset id in
+# confirm_ui/result.json (animations.json accepts version/defaults/slides and
+# nothing else), so it writes a defaults-only sidecar: page transitions but zero
+# element animation. Without this hook the user must remember to run
+# overlay/animations/apply_preset.py by hand, and a forgotten run silently ships
+# a deck with no animation. Expanding here — the last step that reads the
+# sidecar — makes the standard Step 7 command sufficient on its own.
+def _shiftdeck_project_path(argv):
+    """Return the project directory from an argv, ignoring option values.
+
+    Matching on "is a directory that looks like a project" is what keeps option
+    values (``-o out.pptx``, ``-f ppt169``) from being mistaken for the target.
+    """
+    for arg in argv:
+        if arg.startswith('-'):
+            continue
+        candidate = Path(arg)
+        if candidate.is_dir() and (
+            (candidate / 'svg_output').is_dir()
+            or (candidate / 'spec_lock.md').is_file()
+        ):
+            return candidate
+    return None
+
+
+def _shiftdeck_animation_overlay():
+    """Import overlay/animations/shiftdeck_animations.py, or return ``None``."""
+    for parent in Path(__file__).resolve().parents:
+        overlay = parent / 'overlay' / 'animations'
+        if not (overlay / 'shiftdeck_animations.py').is_file():
+            continue
+        if str(overlay) not in sys.path:
+            sys.path.insert(0, str(overlay))
+        import shiftdeck_animations  # noqa: PLC0415
+
+        return shiftdeck_animations
+    return None
+
+
+def _shiftdeck_auto_animations(argv) -> None:
+    """Expand the confirmed preset into animations.json before exporting.
+
+    Deliberately narrow so it cannot surprise anyone:
+    * no ``deck_animation.preset`` in result.json  -> does nothing (upstream);
+    * animations.json already has ``slides``       -> does nothing, so a
+      hand-tuned sidecar from the live preview is never overwritten;
+    * ``--no-animations`` / ``--animation-config`` -> does nothing, the caller
+      already said what it wants.
+    Any failure degrades to a stderr warning; the export itself continues.
+    """
+    if '--no-animations' in argv or '--animation-config' in argv:
+        return
+    project_path = _shiftdeck_project_path(argv)
+    if project_path is None:
+        return
+    try:
+        overlay = _shiftdeck_animation_overlay()
+        if overlay is None:
+            return
+        preset_id = overlay.selected_preset_id(project_path)
+        if not preset_id:
+            return
+        existing = overlay.read_config(project_path)
+        if existing and existing.get('slides'):
+            return
+        svg_dir = project_path / 'svg_output'
+        if not svg_dir.is_dir() or not any(svg_dir.glob('*.svg')):
+            return
+        written, errors = overlay.apply_preset(
+            project_path, preset_id, keep_slides=False,
+        )
+    except Exception as exc:  # noqa: BLE001 - never block an export
+        print(
+            f'Warning: shiftdeck could not expand the animation preset: {exc}',
+            file=sys.stderr,
+        )
+        return
+    if errors:
+        print(
+            'Warning: shiftdeck animation preset expansion rejected: '
+            + errors[0],
+            file=sys.stderr,
+        )
+        return
+    if written:
+        print(
+            f"[shiftdeck] expanded animation preset '{preset_id}' into "
+            f'{written}',
+            file=sys.stderr,
+        )
+
+
 if __name__ == '__main__':
     require_skill_integrity()
+    _shiftdeck_auto_animations(sys.argv[1:])
     raise SystemExit(main())
