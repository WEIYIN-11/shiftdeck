+_SHIFTDECK_ANIMATIONS: Optional[object] = None
+_SHIFTDECK_ANIMATIONS_TRIED = False
+
+
+def _shiftdeck_animations():
+    """Import the shiftdeck animation overlay once, or return ``None``."""
+    global _SHIFTDECK_ANIMATIONS, _SHIFTDECK_ANIMATIONS_TRIED
+    if _SHIFTDECK_ANIMATIONS_TRIED:
+        return _SHIFTDECK_ANIMATIONS
+    _SHIFTDECK_ANIMATIONS_TRIED = True
+    for parent in _SCRIPTS_DIR.parents:
+        overlay = parent / 'overlay' / 'animations'
+        if not (overlay / 'shiftdeck_animations.py').is_file():
+            continue
+        if str(overlay) not in sys.path:
+            sys.path.insert(0, str(overlay))
+        try:
+            import shiftdeck_animations  # noqa: PLC0415
+        except ImportError as exc:
+            logger.warning('shiftdeck animation overlay not importable: %s', exc)
+            break
+        _SHIFTDECK_ANIMATIONS = shiftdeck_animations
+        break
+    return _SHIFTDECK_ANIMATIONS
+
+
+def _normalize_deck_animation(result: dict) -> Optional[str]:
+    """Validate ``deck_animation`` against the overlay's preset catalog."""
+    raw = result.get('deck_animation')
+    if raw is None:
+        return None
+    if isinstance(raw, str):
+        raw = {'preset': raw}
+    if not isinstance(raw, dict):
+        return 'deck_animation must be an object with a "preset" field'
+    preset_id = str(raw.get('preset') or '').strip()
+    overlay = _shiftdeck_animations()
+    if not preset_id or overlay is None:
+        result.pop('deck_animation', None)
+        return None
+    if preset_id != overlay.NO_PRESET and preset_id not in overlay.preset_ids():
+        return f'deck_animation.preset is not a known preset: {preset_id}'
+    result['deck_animation'] = {'preset': preset_id}
+    return None
+
+
+def _apply_deck_animation(project_path: Path, result: dict) -> None:
+    """Write ``<project>/animations.json`` for the confirmed preset.
+
+    A missing or ``none`` preset writes nothing at all, so a deck whose user
+    never picked an animation keeps the engine's own defaults byte for byte.
+    """
+    overlay = _shiftdeck_animations()
+    if overlay is None:
+        return
+    deck_animation = result.get('deck_animation')
+    if not isinstance(deck_animation, dict):
+        return
+    preset_id = str(deck_animation.get('preset') or '').strip()
+    if not preset_id or preset_id == overlay.NO_PRESET:
+        return
+    svg_dir = project_path / 'svg_output'
+    defaults_only = not (svg_dir.is_dir() and any(svg_dir.glob('*.svg')))
+    try:
+        written, errors = overlay.apply_preset(
+            project_path,
+            preset_id,
+            defaults_only=defaults_only,
+        )
+    except (OSError, ValueError, RuntimeError, json.JSONDecodeError) as exc:
+        logger.warning('deck animation preset %s not applied: %s', preset_id, exc)
+        return
+    if errors:
+        logger.warning(
+            'deck animation preset %s rejected by the engine validator: %s',
+            preset_id,
+            '; '.join(errors),
+        )
+        return
+    logger.info('deck animation preset %s written to %s', preset_id, written)
+
